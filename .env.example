# ==============================================================================
# SATA (SataQuery Sentinel) - Environment Variables Example
# Meta Global AI Developer Hackathon 2026
# ==============================================================================

# Meta Model API Key (Get from Meta Developer Portal / Cerebral Valley)
META_API_KEY=your_meta_api_key_here
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Vite / SPA frontend compatibility variables
VITE_META_API_KEY=your_meta_api_key_here
VITE_META_BASE_URL=https://api.meta.ai/v1
VITE_META_MODEL=muse-spark-1.3

# Alternative Llama endpoint support
LLAMA_API_BASE_URL=https://api.llama.com/compat/v1
LLAMA_MODEL_ID=Llama-4-Maverick-17B-128E-Instruct-FP8

# NASA FIRMS (Fire Information for Resource Management System) MAP_KEY (Free)
NASA_FIRMS_KEY=
NASA_FIRMS_MAP_KEY=

# Default Geospatial Target: Chennai, Tamil Nadu, India
DEFAULT_LATITUDE=13.0827
DEFAULT_LONGITUDE=80.2707
DEFAULT_BBOX=80.10,12.90,80.35,13.20
